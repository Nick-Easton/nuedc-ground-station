<launch>
  <arg name="start_yolo" default="true"/>
  <arg name="start_grid_recognition" default="true"/>
  <arg name="camera" default="/dev/video0"/>
  <arg name="image_width" default="640"/>
  <arg name="image_height" default="480"/>
  <arg name="fps" default="30"/>
  <arg name="engine" default="$(env HOME)/catkin_ws_yolo_trt/src/yolo_trt_ros/models/best.engine"/>
  <arg name="confidence" default="0.60"/>
  <arg name="iou_threshold" default="0.45"/>
  <arg name="show_window" default="false"/>
  <arg name="max_rate" default="5.0"/>
  <arg name="max_detections" default="10"/>
  <arg name="current_grid_topic" default="/current_grid"/>
  <arg name="publish_vision_goal" default="false"/>
  <arg name="vision_goal_max_forward_step" default="0.20"/>
  <arg name="vision_goal_max_lateral_step" default="0.10"/>
  <arg name="vision_goal_center_deadband_px" default="20.0"/>
  <arg name="vision_goal_confirmation_window_frames" default="5"/>
  <arg name="vision_goal_confirmation_min_frames" default="3"/>
  <arg name="vision_goal_confirmation_center_distance_px" default="40.0"/>
  <arg name="vision_goal_cooldown_seconds" default="2.0"/>
  <arg name="vision_goal_dedup_distance_px" default="60.0"/>
  <arg name="grid_min_confirmation_frames" default="3"/>

  <include if="$(arg start_yolo)" file="$(find yolo_trt_ros)/launch/yolo_trt_usb_cam.launch">
    <arg name="camera" value="$(arg camera)"/>
    <arg name="image_width" value="$(arg image_width)"/>
    <arg name="image_height" value="$(arg image_height)"/>
    <arg name="fps" value="$(arg fps)"/>
    <arg name="engine" value="$(arg engine)"/>
    <arg name="conf_thres" value="$(arg confidence)"/>
    <arg name="iou_thres" value="$(arg iou_threshold)"/>
    <arg name="show_window" value="$(arg show_window)"/>
  </include>

  <node pkg="nuedc_ground_air" type="vision_detection_adapter.py" name="vision_detection_adapter" output="screen">
    <param name="input_topic" value="/yolo_trt_node/detections"/>
    <param name="output_topic" value="/vision/detections"/>
    <param name="summary_topic" value="/vision/summary"/>
    <param name="vision_goal_topic" value="/mission/vision_goal"/>
    <param name="publish_vision_goal" value="$(arg publish_vision_goal)"/>
    <param name="min_confidence" value="$(arg confidence)"/>
    <param name="max_rate" value="$(arg max_rate)"/>
    <param name="max_detections" value="$(arg max_detections)"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="vision_goal_max_forward_step" value="$(arg vision_goal_max_forward_step)"/>
    <param name="vision_goal_max_lateral_step" value="$(arg vision_goal_max_lateral_step)"/>
    <param name="vision_goal_center_deadband_px" value="$(arg vision_goal_center_deadband_px)"/>
    <param name="vision_goal_confirmation_window_frames" value="$(arg vision_goal_confirmation_window_frames)"/>
    <param name="vision_goal_confirmation_min_frames" value="$(arg vision_goal_confirmation_min_frames)"/>
    <param name="vision_goal_confirmation_center_distance_px" value="$(arg vision_goal_confirmation_center_distance_px)"/>
    <param name="vision_goal_cooldown_seconds" value="$(arg vision_goal_cooldown_seconds)"/>
    <param name="vision_goal_dedup_distance_px" value="$(arg vision_goal_dedup_distance_px)"/>
    <rosparam param="class_names">[elephant, tiger, monkey, kongque, wolf]</rosparam>
  </node>

  <node if="$(arg start_grid_recognition)" pkg="nuedc_ground_air" type="grid_recognition_state_machine.py" name="grid_recognition_state_machine" output="screen">
    <param name="stabilize_seconds" value="0.3"/>
    <param name="recognition_seconds" value="1.0"/>
    <param name="min_confidence" value="$(arg confidence)"/>
    <param name="min_confirmation_frames" value="$(arg grid_min_confirmation_frames)"/>
    <param name="current_grid_topic" value="$(arg current_grid_topic)"/>
    <param name="detection_topic" value="/vision/detections"/>
  </node>
</launch>
