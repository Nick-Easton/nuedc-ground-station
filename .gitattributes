* text=auto

# Keep scripts and ROS/CMake sources executable-friendly on Ubuntu.
*.py text eol=lf
*.sh text eol=lf
*.launch text eol=lf
*.service text eol=lf
*.xml text eol=lf
*.msg text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
